{
  "manifest_version": 2,
  "id": "rvosy.sakura-tts",
  "version": "0.2.5",
  "name": "SakuraTTS 语音合成",
  "description": "候选版：Replyer 同时生成中文回复与可选日语台词，通过回复扩展合成语音。",
  "author": {
    "name": "Rvosy",
    "url": "https://github.com/Rvosy"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Rvosy/SakuraTTS"
  },
  "host_application": {
    "min_version": "1.3.14",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.16.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.28.1,<1"
    }
  ],
  "capabilities": [
    "send.hybrid",
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
