include README.md LICENSE AGENTS.md pyproject.toml MANIFEST.in start-server.bat api.py api_v2.py
include uv.lock
recursive-include requirements *.txt
recursive-include packaging *.toml *.json
recursive-include sakuratts *.py
recursive-include scripts *.py *.ps1 *.sh *.bat *.command *.md
recursive-include benchmarks *.py *.json *.md
recursive-include tools *.py *.ps1 *.md
recursive-include tests *.py *.json
recursive-include docs *.md *.txt *.json *.html
recursive-include examples *.py *.json *.md *.yaml
global-exclude *.pyc *.pyo
prune data
prune models
prune outputs
prune build
prune dist
prune research
